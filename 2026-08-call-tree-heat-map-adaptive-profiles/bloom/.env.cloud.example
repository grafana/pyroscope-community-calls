# Send profiles and traces to a Grafana Cloud stack instead of the bundled
# Pyroscope and Tempo. Copy to .env.cloud and fill in, then:
#
#   make up-cloud
#
# The bundled Pyroscope, Tempo and Grafana keep running and keep serving
# whatever they already ingested; they simply stop receiving new data.

# Profiles: stack details page -> Pyroscope -> "Sending profiles"
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-000.grafana.net
PYROSCOPE_BASIC_AUTH_USER=123456
PYROSCOPE_BASIC_AUTH_PASSWORD=glc_...

# Traces via the OTLP gateway: stack details page -> OpenTelemetry -> "Configure"
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic <base64 of instance:token>"

# SERVICE_GIT_REF deliberately does not live here: the Makefile derives it from
# the checkout and exports it, and an exported variable beats an env-file entry,
# so a value set here would be silently ignored. Use `make up-cloud
# SERVICE_GIT_REF=...` to force one.

LOAD_DURATION=12h
CHECKOUT_RATE=6
