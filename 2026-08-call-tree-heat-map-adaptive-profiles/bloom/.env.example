# Nothing here is required: with no .env at all, profiles go to the bundled
# Pyroscope, traces to the bundled Tempo, and both are wired up in the bundled
# Grafana. Copy this file to .env only if you want to change one of these.

# Send telemetry to a Grafana Cloud stack instead of the bundled backends.
# PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-000.grafana.net:443
# PYROSCOPE_BASIC_AUTH_USER=123456
# PYROSCOPE_BASIC_AUTH_PASSWORD=glc_...
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance:token>

# Extra static labels attached to all profiles
# PYROSCOPE_LABELS=env=demo,namespace=bloom

# Load generator: how long one k6 run lasts before Compose restarts it, and how
# many checkouts per second it drives.
# LOAD_DURATION=12h
# CHECKOUT_RATE=6
