# Copy to .env and fill in your Grafana Cloud stack details.
#
# Profiles (Pyroscope): stack details page -> Pyroscope -> "Sending profiles"
#   - server address looks like https://profiles-prod-<NNN>.grafana.net:443
#   - user is the numeric Pyroscope instance/tenant ID
#   - password is a Cloud Access Policy token with profiles:write
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-000.grafana.net:443
PYROSCOPE_BASIC_AUTH_USER=123456
PYROSCOPE_BASIC_AUTH_PASSWORD=glc_...

# Traces via the OTLP gateway: stack details page -> OpenTelemetry -> "Configure"
#   - endpoint looks like https://otlp-gateway-prod-<region>.grafana.net/otlp
#   - header value is base64("<otlp instance id>:<token>"), %20 encodes the space
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 of instance:token>

# Extra static labels attached to all profiles
PYROSCOPE_LABELS=env=demo

# How long `make load` runs
LOAD_DURATION=20m
