# Local rehearsal mode: profiles go to the bundled Pyroscope, traces to the
# bundled Tempo (both started with `make up-local`), explorable in the bundled
# Grafana at http://localhost:3000 (anonymous access, no login).
PYROSCOPE_SERVER_ADDRESS=http://pyroscope:4040
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
LOAD_DURATION=20m
